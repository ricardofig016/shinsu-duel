{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shinsu-duel/card.schema.json",
  "title": "Shinsu Duel YAML Card Schema",
  "description": "Schema for source card definitions in data/cards/*.yml. This validates authoring data before compilation; it is not the schema for server/data/cards.json. Effects, abilities, and passives are structured DSL nodes (see docs/COMPILED_CARD_DSL.md).",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "filterValue": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    },
    "unitFilter": {
      "type": "object",
      "properties": {
        "condition": { "type": "string", "minLength": 1 },
        "conditionValue": { "type": "integer", "minimum": 0 },
        "trait": { "type": "string", "minLength": 1 },
        "rank": { "$ref": "#/definitions/filterValue" },
        "position": { "$ref": "#/definitions/filterValue" },
        "affiliation": { "$ref": "#/definitions/filterValue" },
        "attribute": { "$ref": "#/definitions/filterValue" },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "predicateTarget": {
      "type": "object",
      "required": ["side"],
      "properties": {
        "side": { "enum": ["ally", "enemy", "any"] },
        "condition": { "type": "string", "minLength": 1 },
        "conditionValue": { "type": "integer", "minimum": 0 },
        "trait": { "type": "string", "minLength": 1 },
        "rank": { "$ref": "#/definitions/filterValue" },
        "position": { "$ref": "#/definitions/filterValue" },
        "affiliation": { "$ref": "#/definitions/filterValue" },
        "attribute": { "$ref": "#/definitions/filterValue" },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "unitTarget": {
      "type": "object",
      "required": ["side"],
      "properties": {
        "side": { "enum": ["self", "bearer", "ally", "enemy", "any"] },
        "scope": { "enum": ["single", "all", "frontline", "backline"] },
        "count": { "type": "integer", "minimum": 1 },
        "choose": { "type": "boolean" },
        "random": { "type": "boolean" },
        "condition": { "type": "string", "minLength": 1 },
        "conditionValue": { "type": "integer", "minimum": 0 },
        "trait": { "type": "string", "minLength": 1 },
        "traitNot": { "type": "string", "minLength": 1 },
        "lowest_hp": { "type": "boolean" },
        "rank": { "$ref": "#/definitions/filterValue" },
        "position": { "$ref": "#/definitions/filterValue" },
        "affiliation": { "$ref": "#/definitions/filterValue" },
        "attribute": { "$ref": "#/definitions/filterValue" },
        "name": { "type": "string", "minLength": 1 },
        "cost": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "enum": ["cheapest", "most expensive"] }] }
      },
      "additionalProperties": false
    },
    "cardTarget": {
      "type": "object",
      "properties": {
        "zone": { "enum": ["hand", "deck", "discard"] },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["unit", "skill", "equipment"] },
        "cost": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "enum": ["cheapest", "most expensive"] }] },
        "rank": { "$ref": "#/definitions/filterValue" },
        "position": { "$ref": "#/definitions/filterValue" },
        "affiliation": { "$ref": "#/definitions/filterValue" },
        "attribute": { "$ref": "#/definitions/filterValue" },
        "choose": { "type": "boolean" },
        "random": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "resourceCost": {
      "type": "object",
      "required": ["resource", "amount"],
      "properties": {
        "resource": { "type": "string", "minLength": 1 },
        "amount": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "deckConstraint": {
      "type": "object",
      "required": ["type", "raw"],
      "properties": {
        "type": { "enum": ["unreachable", "generated_by"] },
        "raw": { "type": "string", "minLength": 1 },
        "resource": { "type": "string", "minLength": 1 },
        "amount": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "type": { "const": "generated_by" } } }, "then": { "required": ["resource", "amount"] } }
      ]
    },
    "predicate": {
      "oneOf": [
        { "type": "object", "required": ["type", "target"], "properties": { "type": { "const": "has_unit" }, "target": { "$ref": "#/definitions/predicateTarget" }, "negate": { "type": "boolean" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "line"], "properties": { "type": { "const": "alone_on_line" }, "line": { "enum": ["frontline", "backline"] }, "negate": { "type": "boolean" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "cardName"], "properties": { "type": { "const": "started_with_card" }, "cardName": { "type": "string", "minLength": 1 }, "negate": { "type": "boolean" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "cardName"], "properties": { "type": { "const": "has_equipped" }, "cardName": { "type": "string", "minLength": 1 }, "negate": { "type": "boolean" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "condition"], "properties": { "type": { "const": "has_condition" }, "condition": { "type": "string", "minLength": 1 }, "conditionValue": { "type": "integer", "minimum": 0 }, "target": { "$ref": "#/definitions/predicateTarget" }, "negate": { "type": "boolean" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "cardNames"], "properties": { "type": { "const": "has_all_equipped" }, "cardNames": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "negate": { "type": "boolean" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "amount"], "properties": { "type": { "const": "has_equipment_count" }, "amount": { "type": "integer", "minimum": 1 }, "negate": { "type": "boolean" } }, "additionalProperties": false }
      ]
    },
    "trigger": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["equip", "slay", "deploy", "given", "kill", "ally_dies", "damaged_by", "round_start", "round_end", "deal_damage", "ability_used", "attack", "summon", "draw", "free_ability_played", "quick_ability_used", "round_start_or_activation", "skill_played", "reclaim", "dies", "enemy_dies", "evolve", "has_all_equipped"] },
        "raw": { "type": "string", "minLength": 1 },
        "cardName": { "type": "string", "minLength": 1 },
        "cardNames": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "target": { "type": "string", "minLength": 1 },
        "rank": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "item": { "type": "string", "minLength": 1 },
        "position": { "type": "string", "minLength": 1 },
        "cardType": { "enum": ["unit", "skill", "equipment"] }
      },
      "additionalProperties": false
    },
    "effectNode": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["charge_shinsu", "spend_shinsu", "compress_shinsu", "reclaim_cards", "create_lighthouse", "destroy_lighthouse", "draw_card", "create_card", "summon", "discard", "steal", "disarm", "switch_position", "deal_damage", "heal", "give_condition", "cleanse", "grant_trait", "remove_traits", "copy_traits", "grant_random_trait", "slay", "transform", "grant_ability", "copy_ability", "peek_hand", "play_jeonsul_baang", "sequence", "conditional", "noop", "repeat_play", "quick", "choose_position", "grant_affiliation", "return_to_hand"] },
        "raw": { "type": "string", "minLength": 1 },
        "quick": { "type": "boolean" },
        "free": { "type": "boolean" },
        "position": { "type": ["string", "null"] },
        "trigger": { "$ref": "#/definitions/trigger" },
        "amount": { "type": "integer", "minimum": 0 },
        "effect": { "$ref": "#/definitions/effectNode" },
        "ability": { "$ref": "#/definitions/effectNode" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/effectNode" } },
        "if": { "$ref": "#/definitions/predicate" },
        "then": { "$ref": "#/definitions/effectNode" },
        "otherwise": { "$ref": "#/definitions/effectNode" },
        "condition": { "type": "string", "minLength": 1 },
        "conditionValue": { "type": "integer", "minimum": 0 },
        "trait": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/definitions/unitTarget" },
        "card": { "$ref": "#/definitions/cardTarget" },
        "source": { "$ref": "#/definitions/unitTarget" },
        "from": { "enum": ["deck", "hand", "deck_or_hand", "game"] },
        "onto": { "enum": ["self", "opponent", "both"] },
        "random": { "type": "boolean" },
        "owner": { "enum": ["you", "opponent", "self", "enemy"] },
        "to": { "enum": ["hand", "discard"] },
        "cardName": { "type": "string", "minLength": 1 },
        "numeric": { "type": "boolean" },
        "cost": { "$ref": "#/definitions/resourceCost" }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "type": { "const": "charge_shinsu" } } }, "then": { "required": ["amount"] } },
        { "if": { "properties": { "type": { "const": "spend_shinsu" } } }, "then": { "required": ["amount", "effect"] } },
        { "if": { "properties": { "type": { "const": "compress_shinsu" } } }, "then": { "required": ["amount", "card"] } },
        { "if": { "properties": { "type": { "const": "reclaim_cards" } } }, "then": { "required": ["amount"] } },
        { "if": { "properties": { "type": { "const": "create_lighthouse" } } }, "then": { "required": ["amount"] } },
        { "if": { "properties": { "type": { "const": "destroy_lighthouse" } } }, "then": { "required": ["amount"] } },
        { "if": { "properties": { "type": { "const": "draw_card" } } }, "then": { "required": ["amount"] } },
        { "if": { "properties": { "type": { "const": "create_card" } } }, "then": { "required": ["card"] } },
        { "if": { "properties": { "type": { "const": "summon" } } }, "then": { "required": ["card", "from", "onto"] } },
        { "if": { "properties": { "type": { "const": "discard" } } }, "then": { "required": ["card", "owner"] } },
        { "if": { "properties": { "type": { "const": "steal" } } }, "then": { "required": ["card"] } },
        { "if": { "properties": { "type": { "const": "disarm" } } }, "then": { "required": ["target", "to"] } },
        { "if": { "properties": { "type": { "const": "switch_position" } } }, "then": { "required": ["target"] } },
        { "if": { "properties": { "type": { "const": "deal_damage" } } }, "then": { "required": ["amount", "target"] } },
        { "if": { "properties": { "type": { "const": "heal" } } }, "then": { "required": ["amount", "target"] } },
        { "if": { "properties": { "type": { "const": "give_condition" } } }, "then": { "required": ["condition", "target"] } },
        { "if": { "properties": { "type": { "const": "cleanse" } } }, "then": { "required": ["target"] } },
        { "if": { "properties": { "type": { "const": "grant_trait" } } }, "then": { "required": ["trait", "target"] } },
        { "if": { "properties": { "type": { "const": "remove_traits" } } }, "then": { "required": ["target"] } },
        { "if": { "properties": { "type": { "const": "copy_traits" } } }, "then": { "required": ["target", "source"] } },
        { "if": { "properties": { "type": { "const": "grant_random_trait" } } }, "then": { "required": ["target"] } },
        { "if": { "properties": { "type": { "const": "slay" } } }, "then": { "required": ["target"] } },
        { "if": { "properties": { "type": { "const": "transform" } } }, "then": { "required": ["cardName"] } },
        { "if": { "properties": { "type": { "const": "grant_ability" } } }, "then": { "required": ["ability", "target"] } },
        { "if": { "properties": { "type": { "const": "copy_ability" } } }, "then": { "required": ["source"] } },
        { "if": { "properties": { "type": { "const": "peek_hand" } } }, "then": { "required": ["owner"] } },
        { "if": { "properties": { "type": { "const": "sequence" } } }, "then": { "required": ["steps"] } },
        { "if": { "properties": { "type": { "const": "conditional" } } }, "then": { "required": ["if", "then"] } },
        { "if": { "properties": { "type": { "const": "repeat_play" } } }, "then": { "required": ["amount"] } },
        { "if": { "properties": { "type": { "const": "grant_affiliation" } } }, "then": { "required": ["target", "source"] } },
        { "if": { "properties": { "type": { "const": "return_to_hand" } } }, "then": { "required": ["target"] } }
      ]
    },
    "modifierNode": {
      "type": "object",
      "required": ["type", "raw"],
      "properties": {
        "type": { "enum": ["modify_stat", "modify_keyword", "modify_targeting", "modify_cost", "modify_condition", "global_rule", "retain_equipment", "modify_repeat"] },
        "raw": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/definitions/unitTarget" },
        "stat": { "enum": ["damage", "heal", "hp", "cost", "damage_taken"] },
        "amount": { "type": "integer" },
        "keyword": { "enum": ["quick", "free"] },
        "first": { "type": "boolean" },
        "rule": { "enum": ["ignore_taunt", "untargetable_by", "disable_passives", "grant_global_trait", "condition_stack_cap", "prevent_evolve", "prevent_equip", "grant_global_condition"] },
        "trait": { "type": "string", "minLength": 1 },
        "condition": { "type": "string", "minLength": 1 },
        "position": { "type": "string", "minLength": 1 },
        "cap": { "type": "integer", "minimum": 1 },
        "when": { "$ref": "#/definitions/unitFilter" },
        "source": { "$ref": "#/definitions/unitFilter" },
        "if": { "$ref": "#/definitions/predicate" }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "type": { "const": "modify_stat" } } }, "then": { "required": ["stat", "amount", "target"] } },
        { "if": { "properties": { "type": { "const": "modify_keyword" } } }, "then": { "required": ["keyword", "target"] } },
        { "if": { "properties": { "type": { "const": "modify_targeting" } } }, "then": { "required": ["rule", "target"] } },
        { "if": { "properties": { "type": { "const": "modify_cost" } } }, "then": { "required": ["amount"] } },
        { "if": { "properties": { "type": { "const": "modify_condition" } } }, "then": { "required": ["condition", "amount", "target"] } },
        { "if": { "properties": { "type": { "const": "global_rule" } } }, "then": { "required": ["rule"] } },
        { "if": { "properties": { "type": { "const": "modify_repeat" } } }, "then": { "required": ["amount", "target"] } }
      ]
    },
    "effectEntry": {
      "oneOf": [
        { "allOf": [{ "$ref": "#/definitions/effectNode" }, { "required": ["raw"] }] },
        { "$ref": "#/definitions/modifierNode" }
      ]
    },
    "alwaysOnNode": {
      "oneOf": [
        { "allOf": [{ "$ref": "#/definitions/effectNode" }, { "properties": { "type": { "enum": ["grant_trait", "give_condition", "noop", "quick"] } } }] },
        { "$ref": "#/definitions/modifierNode" },
        { "allOf": [{ "$ref": "#/definitions/effectNode" }, { "properties": { "type": { "const": "sequence" }, "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/alwaysOnNode" } } } }] },
        { "allOf": [{ "$ref": "#/definitions/effectNode" }, { "properties": { "type": { "const": "conditional" }, "then": { "$ref": "#/definitions/alwaysOnNode" }, "otherwise": { "$ref": "#/definitions/alwaysOnNode" } } }] }
      ]
    },
    "passiveEntry": {
      "allOf": [
        {
          "oneOf": [
            { "allOf": [{ "$ref": "#/definitions/effectNode" }, { "required": ["raw"] }] },
            { "$ref": "#/definitions/modifierNode" }
          ]
        },
        {
          "if": { "not": { "required": ["trigger"] } },
          "then": { "$ref": "#/definitions/alwaysOnNode" }
        }
      ]
    },
    "keyword": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["code", "raw"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "raw": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "properties": {
    "type": { "enum": ["unit", "skill", "equipment"] },
    "name": { "type": "string", "minLength": 1 },
    "sobriquet": { "type": "string", "minLength": 1 },
    "cost": { "type": "integer", "minimum": 0 },
    "hp": { "type": "integer", "minimum": 1 },
    "rank": { "type": ["string", "null"], "enum": ["regular", "ranker", "high ranker", null] },
    "positions": { "type": "array", "items": { "enum": ["fisherman", "light bearer", "scout", "spear bearer", "wave controller", "frontline shinheuh", "backline shinheuh", "landmark"] } },
    "passives": { "type": "array", "items": { "$ref": "#/definitions/passiveEntry" } },
    "abilities": { "type": "array", "items": { "$ref": "#/definitions/effectEntry" } },
    "evolve": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "traits": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "attributes": { "type": "array", "items": { "enum": ["anima", "silver dwarf", "red witch", "hwayeomsa", "jeonsulsa", "irregular", "living ignition weapon"] } },
    "affiliations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "requirements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "effects": { "type": "array", "items": { "$ref": "#/definitions/effectEntry" } },
    "ignition": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "keywords": { "type": "array", "items": { "$ref": "#/definitions/keyword" } },
    "deckConstraints": { "type": "array", "items": { "$ref": "#/definitions/deckConstraint" } }
  },
  "oneOf": [
    { "properties": { "type": { "const": "unit" }, "positions": { "type": "array", "minItems": 1 } }, "required": ["type", "name", "cost", "hp", "rank", "positions", "passives", "abilities", "traits", "attributes", "affiliations"] },
    { "properties": { "type": { "const": "skill" } }, "required": ["type", "name", "cost", "requirements", "effects"] },
    { "properties": { "type": { "const": "equipment" } }, "required": ["type", "name", "cost", "requirements", "effects", "ignition"] }
  ]
}
